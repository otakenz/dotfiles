  _info "CHECK INFORMATION AND VERSIONS"

  cat <<EOF
:: Dotfiles path:

${DOTFILES_PATH}

:: Git user:

$(env -u GIT_CONFIG_GLOBAL git config --get-regex "user.(name|email)")

:: tmux:

$(tmux -V)

:: Neovim:

$(nvim --version)

:: Fastfetch:

EOF

  fastfetch
}

completed_message() {
  _info "SHOWING SSH PUBKEYS"
  echo "$SSH_PUBKEY"
  echo
  echo "$SSH_INSTRUCTIONS"

  _info "EVERYTHING WORKED"

  # --- Secret .env setup reminder ---
  cat <<EOF
Make sure to create the required .env files in each secret/*/ directory (e.g., secret/github/.env).

Please refer to .env.example file for available variables.
These files are gitignored and required for secret-dependent features to work.
EOF

  local work_flag=
  [ "${IS_WORK_PC}" = "1" ] && work_flag=" --work-pc"

  _info "NEXT: RESTORE GPG KEYS AND PASSWORD STORES"

  cat <<EOF
This run did not create a GPG key: your identity comes from your key backup.
Commit signing and gopass start working after the keys phase. When ready:

  1. Register the SSH key(s) shown above on their hosts. The password stores
     are cloned over SSH, so this has to happen first.

  2. Copy your key backup folder onto this machine (or mount the drive), e.g.
     ~/key-backup. The keys phase reads:
       personal-secret.asc  personal-public.asc  ownertrust.txt
EOF
  if [ "${IS_WORK_PC}" = "1" ]; then
    cat <<EOF
       work-secret.asc      work-public.asc
     and asks for the work store URL unless GOPASS_WORK_URL is set.
EOF
  fi
  cat <<EOF

  3. Open a new terminal and run:
       ${DOTFILES_PATH}/install --keys ~/key-backup${work_flag}

EOF

  cat <<EOF
You can safely close this terminal.

The next time you open your terminal everything will be ready to go!
EOF

  if [ "${OS_TYPE}" == "darwin" ]; then
    cat <<EOF

P.S., it looks like you're on macOS.

If you're using iTerm2 as your terminal you'll want to goto Settings ->
Profiles -> Keys (tab) and then change your ALT keys to use "Esc+" instead of
"Normal", otherwise ALT+x keymaps in Neovim may not work.

If you're not using iTerm2 you may still need to do similar steps.
EOF
  fi
}

# -----------------------------------------------------------------------------
# Keys phase: ./install --keys DIR [--work-pc]
# -----------------------------------------------------------------------------

_shred() {
  if command -v shred >/dev/null 2>&1; then
    shred -u "${@}"
  else
    rm -f "${@}"
  fi
}

_keys_ids() {
  echo personal
  if [ "${IS_WORK_PC}" = "1" ]; then echo work; fi
}

_keys_ssh_key() {
  if [ "${1}" = "work" ]; then
    echo "${HOME}/.ssh/id_ed25519_work"
  else
    echo "${HOME}/.ssh/id_ed25519"
  fi
}

# Host of an identity's store URL: github.com from git@github.com:me/store.git
# or ssh://git@github.com/me/store.git; empty for a local path or file:// URL.
_keys_host() {
  local url
  url="$(_keys_url "${1}")"
  case "${url}" in
  *://*) url="${url#*://}" ;;
  *:*) ;;
  *) url= ;;
  esac
  url="${url#*@}"
  echo "${url%%[:/]*}"
}

# The key path is quoted for the shell that git runs GIT_SSH_COMMAND /
# core.sshCommand with, so a HOME containing spaces still works.
_keys_ssh_cmd() {
  printf "ssh -i %q -o IdentitiesOnly=yes" "${1}"
}

_keys_url() {
  if [ "${1}" = "work" ]; then
    echo "${GOPASS_WORK_URL}"
  else
    echo "${GOPASS_PERSONAL_URL}"
  fi
}

_keys_fpr_of_file() {
  gpg --show-keys --with-colons "${1}" 2>/dev/null | awk -F: '$1=="fpr"{print $10; exit}'
}

# Prints "<capabilities> <secret> <expiry> <fingerprint>" per subkey of $1,
# where secret is "+" when usable on this machine and "#" for a stub.
_keys_subkeys() {
  gpg -K --with-colons --with-subkey-fingerprint "${1}" 2>/dev/null |
    awk -F: '$1=="ssb"{cap=$12; sec=($15=="#")?"#":"+"; ex=$7; want=1; next}
             $1=="fpr" && want {print cap, sec, (ex==""?"never":ex), $10; want=0}'
}

# True when an encryption subkey is neither expired nor revoked; it is the only
# key that can open the password store. A renewal updates only *-public.asc,
# so each subkey counts with its latest expiry across all files given, as gpg
# does when it imports them together.
_keys_usable_encryption() {
  local file
  for file in "${@}"; do
    gpg --show-keys --with-colons --with-subkey-fingerprint "${file}" 2>/dev/null
  done | awk -F: -v now="$(date +%s)" '
    $1=="ssb" || $1=="sub" {enc = ($12 ~ /e/); rev = ($2=="r"); exp_ = ($7=="" ? "never" : $7); want=1; next}
    $1=="fpr" && want {
      want=0
      if (!enc) next
      if (rev) revoked[$10]=1
      if (exp_=="never" || best[$10]=="never") best[$10]="never"
      else if (exp_+0 > best[$10]+0) best[$10]=exp_
    }
    END {
      for (k in best) if (!(k in revoked) && (best[k]=="never" || best[k] > now)) ok=1
      exit !ok
    }'
}

_keys_primary_secret() {
  gpg -K --with-colons "${1}" 2>/dev/null | awk -F: '$1=="sec"{print ($15=="#")?"#":"+"; exit}'
}

_keys_public_fprs() {
  gpg --show-keys --with-colons --with-subkey-fingerprint "${1}" 2>/dev/null |
    awk -F: '$1=="fpr"{print $10}'
}

_keys_libgcrypt_bug() {
  gpg --version 2>/dev/null | grep -q 'libgcrypt 1\.12\.0$'
}

_keys_libgcrypt_note() {
  cat <<EOF >&2

⚠️  This gpg uses libgcrypt 1.12.0, which randomly rejects valid imported
   cv25519 (encryption) keys with "Bad passphrase" / "Bad secret key" even
   when the passphrase is right (Ubuntu LP #2174038, fixed in 1.12.1).
   Upgrade libgcrypt20 to 1.12.1 or newer before trusting such an error.
EOF
}

_keys_on_exit() {
  local status=$?

  # A second Ctrl-C must not cut the rollback short; ignored signals are
  # inherited, so the gpg call below cannot be interrupted either.
  trap '' INT TERM HUP

  if [ -n "${KEYS_ROLLBACK_FPR}" ]; then
    printf "\n\e[31;1mKeys phase interrupted:\e[0m removing %s from this keyring...\n" "${KEYS_ROLLBACK_FPR}" >&2
    gpg --batch --yes --delete-secret-and-public-key "${KEYS_ROLLBACK_FPR}" >/dev/null 2>&1 || true
    if [ "$(_keys_primary_secret "${KEYS_ROLLBACK_FPR}")" = "+" ]; then
      cat <<EOF >&2

‼️  Could not remove the key: its PRIMARY SECRET IS STILL ON THIS MACHINE.
   Remove it by hand now:
     gpg --delete-secret-and-public-key ${KEYS_ROLLBACK_FPR}
EOF
      exit "${status}"
    fi
    cat <<EOF >&2
The identity is gone from this machine again, so the primary key is not left
behind. Fix the error above and re-run the same './install --keys' command.
EOF
    if _keys_libgcrypt_bug; then _keys_libgcrypt_note; fi
  fi

  if [ -n "${KEYS_TMP}" ] && [ -d "${KEYS_TMP}" ]; then
    find "${KEYS_TMP}" -type f -exec sh -c 'command -v shred >/dev/null && shred -u "$@" || rm -f "$@"' _ {} +
    rm -rf "${KEYS_TMP}"
  fi

  exit "${status}"
}

_keys_preflight() {
  local dir="${1}" cmd id file key url fpr

  for cmd in gpg gopass git; do
    command -v "${cmd}" >/dev/null 2>&1 ||
      _error "'${cmd}' not found. Run './install' first, then open a new terminal."
  done

  [ -f "${dir}/ownertrust.txt" ] || _error "'${dir}/ownertrust.txt' is missing"

  for id in $(_keys_ids); do
    for file in "${id}-secret.asc" "${id}-public.asc"; do
      [ -f "${dir}/${file}" ] || _error "'${dir}/${file}' is missing"
    done
    fpr="$(_keys_fpr_of_file "${dir}/${id}-secret.asc")"
    [ -n "${fpr}" ] || _error "Cannot read a key from '${dir}/${id}-secret.asc'"
    grep -q "^${fpr}:" "${dir}/ownertrust.txt" ||
      _error "'${dir}/ownertrust.txt' has no entry for the ${id} key ${fpr}"
    _keys_usable_encryption "${dir}/${id}-secret.asc" "${dir}/${id}-public.asc" ||
      _error "The ${id} encryption subkey expired (or was revoked). Renew it on a machine
holding the primary first, see 'How to renew a GPG key' in the README."
  done

  if [ "${IS_WORK_PC}" = "1" ] && [ -z "${GOPASS_WORK_URL}" ]; then
    [ "${NON_INTERACTIVE}" = "true" ] && _error "Set GOPASS_WORK_URL to the work store's git URL"
    read -rp "Git URL of your work gopass store: " GOPASS_WORK_URL
    [ -n "${GOPASS_WORK_URL}" ] || _error "The work store URL is required on a work PC"
  fi

  for id in $(_keys_ids); do
    [ -d "${GOPASS_STORES_PATH}/${id}/.git" ] && continue

    key="$(_keys_ssh_key "${id}")"
    url="$(_keys_url "${id}")"
    GIT_SSH_COMMAND="$(_keys_ssh_cmd "${key}")" git ls-remote "${url}" >/dev/null 2>&1 ||
      _error "Cannot reach the ${id} store at '${url}' with ${key}. Register that SSH key on the host first."
  done

  echo "Backup folder, tools and store remotes look good"
  if _keys_libgcrypt_bug; then _keys_libgcrypt_note; fi
}

_keys_restore_identity() {
  local id="${1}" dir="${2}"
  local fpr now expire_arg new_sign line
  local before=() keep=() encrypt=()

  _info "RESTORING ${id^^} GPG IDENTITY"

  fpr="$(_keys_fpr_of_file "${dir}/${id}-secret.asc")"
  [ -n "${fpr}" ] || _error "Cannot read a key from '${dir}/${id}-secret.asc'"

  if [ "$(_keys_primary_secret "${fpr}")" = "#" ] &&
    _keys_subkeys "${fpr}" | awk '$1 ~ /s/ && $2=="+"' | grep -q .; then
    echo "Skipping, since this machine already has its own signing subkey for ${fpr}"
    return 0
  fi

  # A rollback deletes the identity, so it must only ever cover keys this run
  # imported, never a primary that was already here (e.g. the offline machine).
  if [ "$(_keys_primary_secret "${fpr}")" = "+" ]; then
    _error "This keyring already holds the primary secret of ${fpr}.
--keys is for machines that keep only subkeys; it will not touch this key.
On a machine that should hold subkeys only, drop the primary first:
    gpg --delete-secret-keys '${fpr}!'"
  fi

  KEYS_ROLLBACK_FPR="${fpr}"

  # 1. Primary, shared encryption subkey and every published signing subkey.
  #    Ownertrust is per identity so a personal machine never trusts work keys.
  gpg --import "${dir}/${id}-secret.asc" "${dir}/${id}-public.asc"
  grep "^${fpr}:" "${dir}/ownertrust.txt" | gpg --import-ownertrust
  mapfile -t before < <(_keys_subkeys "${fpr}" | awk '{print $4}')

  # 2. This machine's signing subkey; it expires with the encryption subkey
  #    so the identity keeps a single renewal date.
  now="$(date +%s)"
  # Latest expiry among the usable encryption subkeys; "never" beats any date.
  line="$(_keys_subkeys "${fpr}" | awk -v now="${now}" '
    $1 ~ /e/ && $2=="+" {
      if ($3 == "never") { best = "never" }
      else if (best != "never" && $3 > now && $3 > best + 0) { best = $3 }
    }
    END { print best }')"
  [ -n "${line}" ] || _error "No usable encryption subkey in '${dir}/${id}-secret.asc'"
  expire_arg="never"
  if [ "${line}" != "never" ]; then
    expire_arg="seconds=$((line - now))"
  fi
  gpg --batch --quick-add-key "${fpr}" ed25519 sign "${expire_arg}"

  new_sign="$(_keys_subkeys "${fpr}" | awk '$1 ~ /s/ && $2=="+" {print $4}' |
    grep -v -F -x -f <(printf "%s\n" "${before[@]}") || true)"
  [ "$(echo "${new_sign}" | grep -c .)" = "1" ] || _error "Could not identify the new signing subkey"

  # 3. Keep only the encryption subkey(s) and the new signing subkey, then
  #    drop every other secret, the primary included.
  mapfile -t encrypt < <(_keys_subkeys "${fpr}" | awk '$1 ~ /e/ && $2=="+" {print $4}')
  keep=("${encrypt[@]/%/!}" "${new_sign}!")

  KEYS_TMP="$(mktemp -d)"
  chmod 700 "${KEYS_TMP}"
  gpg --armor --export-secret-subkeys "${keep[@]}" >"${KEYS_TMP}/subkeys.asc"
  [ "$(gpg --show-keys --with-colons "${KEYS_TMP}/subkeys.asc" | grep -c '^ssb:')" = "${#keep[@]}" ] ||
    _error "Subkey export is incomplete, nothing was deleted"

  # Must stay the full fingerprint: a short ID or email could match other keys.
  gpg --batch --yes --delete-secret-keys "${fpr}"
  gpg --import "${KEYS_TMP}/subkeys.asc"
  _shred "${KEYS_TMP}/subkeys.asc"

  # 4. Verify the shape: primary offline, only our subkeys usable.
  [ "$(_keys_primary_secret "${fpr}")" = "#" ] || _error "The primary secret is still on this machine"
  _keys_subkeys "${fpr}" | awk -v s="${new_sign}" '$2=="+" && $1 ~ /[sa]/ && $4!=s {bad=1} END{exit bad}' ||
    _error "Another machine's signing subkey is still usable here"
  [ "$(printf 'keys-check' | gpg --batch --encrypt --recipient "${fpr}" | gpg --batch --decrypt 2>/dev/null)" = "keys-check" ] ||
    _error "Encrypt/decrypt roundtrip failed for ${fpr}"

  # 5. Publishable block: must still carry every subkey we started with.
  gpg --armor --export "${fpr}" >"${KEYS_TMP}/public.asc"
  local published=()
  mapfile -t published < <(_keys_public_fprs "${KEYS_TMP}/public.asc")
  for line in "${before[@]}" "${new_sign}"; do
    printf "%s\n" "${published[@]}" | grep -q -x "${line}" || _error "Export lost subkey ${line}"
  done

  KEYS_PUBLIC[${id}]="${dir}/${id}-public.asc"
  if ! cp "${KEYS_TMP}/public.asc" "${KEYS_PUBLIC[${id}]}" 2>/dev/null; then
    KEYS_PUBLIC[${id}]="${HOME}/${id}-public.asc"
    cp "${KEYS_TMP}/public.asc" "${KEYS_PUBLIC[${id}]}"
    echo "Backup folder is read-only, wrote the public block to ${KEYS_PUBLIC[${id}]}"
  fi
  rm -rf "${KEYS_TMP}"
  KEYS_TMP=

  KEYS_ROLLBACK_FPR=
  KEYS_RESTORED+=("${id}")

  gpg -K "${fpr}"
}

_keys_enable_signing() {
  local file="${1}" fpr="${2}"

  git config --file "${file}" user.signingkey "${fpr}"
  git config --file "${file}" commit.gpgsign true
  git config --file "${file}" tag.gpgSign true
  git config --file "${file}" gpg.program gpg
}

_keys_configure_git() {
  local dir="${1}"
  local git_dir="${HOME}/.config/git"
  local personal_fpr uid
  personal_fpr="$(_keys_fpr_of_file "${dir}/personal-secret.asc")"

  _info "ENABLING COMMIT SIGNING"

  if [ "${IS_WORK_PC}" != "1" ]; then
    _keys_enable_signing "${git_dir}/config.local" "${personal_fpr}"
    echo "Signing with ${personal_fpr} via ${git_dir}/config.local"
    return 0
  fi

  _keys_enable_signing "${git_dir}/config.local" "$(_keys_fpr_of_file "${dir}/work-secret.asc")"

  # Personal repositories on a work PC opt in to the personal identity.
  local personal="${git_dir}/config.local.personal"
  if [ ! -f "${personal}" ]; then
    uid="$(gpg --list-keys --with-colons "${personal_fpr}" | awk -F: '$1=="uid"{print $10; exit}')"
    cat <<EOF >"${personal}"
[user]
  name = ${uid% <*}
  email = $(echo "${uid}" | sed -E 's/.*<(.*)>.*/\1/')
[core]
  sshCommand = "ssh -i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes"
EOF
  fi
  _keys_enable_signing "${personal}" "${personal_fpr}"

  if git -C "${DOTFILES_PATH}" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "${DOTFILES_PATH}" config --local include.path "${personal}"
  fi

  echo "Work repositories sign via ${git_dir}/config.local"
  echo "Personal repositories include ${personal}"
}

_keys_clone_store() {
  local id="${1}" dir="${2}"
  local path="${GOPASS_STORES_PATH}/${id}" fpr key url

  _info "CLONING ${id^^} PASSWORD STORE"

  if [ -d "${path}/.git" ]; then
    echo "Skipping, since '${path}' already exists"
    return 0
  fi

  key="$(_keys_ssh_key "${id}")"
  url="$(_keys_url "${id}")"

  # gopass 1.17 'clone --path' for the root store keeps looking at the default
  # path afterwards, so clone with git and register the store explicitly.
  GIT_SSH_COMMAND="$(_keys_ssh_cmd "${key}")" git clone "${url}" "${path}"
  git -C "${path}" config diff.gpg.textconv "gpg --no-tty --decrypt"
  git -C "${path}" config diff.gpg.binary true
  git -C "${path}" config pull.rebase false
  git -C "${path}" config push.default matching
  git -C "${path}" config core.sshCommand "$(_keys_ssh_cmd "${key}")"

  if [ "${id}" = "work" ]; then
    gopass mounts add work "${path}"
  else
    gopass config mounts.path "${path}"
    rmdir "${GOPASS_STORES_PATH}/root" 2>/dev/null || true
  fi

  if [ "${id}" = "personal" ] && [ "${IS_WORK_PC}" = "1" ]; then
    git -C "${path}" config --local include.path "${HOME}/.config/git/config.local.personal"
  fi

  fpr="$(_keys_fpr_of_file "${dir}/${id}-secret.asc")"
  local recipient listed=
  while read -r recipient; do
    [ -n "${recipient}" ] || continue
    if gpg --list-keys --with-colons -- "${recipient}" 2>/dev/null |
      awk -F: '$1=="fpr"{print $10}' | grep -q -x "${fpr}"; then
      listed=1
    fi
  done <"${path}/.gpg-id"
  if [ -z "${listed}" ]; then
    echo "⚠️  '${path}/.gpg-id' does not list ${fpr}; entries may not decrypt here"
  fi
}

_keys_summary() {
  local dir="${1}" id fpr host file cleanup
  if command -v shred >/dev/null 2>&1; then
    cleanup="$(printf "find %q -type f -exec shred -u {} + && rm -r %q" "${dir}" "${dir}")"
  else
    cleanup="$(printf "rm -r %q" "${dir}")"
  fi

  _info "KEYS PHASE COMPLETE"

  gopass mounts || true

  if [ "${#KEYS_RESTORED[@]}" -gt 0 ]; then
    cat <<EOF

This machine added a signing subkey, so each GitHub account needs the updated
public key; until then, commits signed here show as "Unverified". GitHub cannot
update a key in place: delete the old entry, then add the new block (same key ID).
Run these yourself; the first line (once per host) lets gh change GPG keys:

EOF
    for id in "${KEYS_RESTORED[@]}"; do
      fpr="$(_keys_fpr_of_file "${dir}/${id}-secret.asc")"
      host="$(_keys_host "${id}")"
      host="${host:-<git-host>}"
      file="$(printf "%q" "${KEYS_PUBLIC[${id}]}")"
      cat <<EOF
  • ${id} key ${fpr}
      gh auth refresh -h ${host} -s admin:gpg_key
      GH_HOST=${host} gh gpg-key delete ${fpr: -16} --yes
      GH_HOST=${host} gh gpg-key add ${file} --title ${id}
    or by hand: https://${host}/settings/keys

EOF
    done
  fi

  cat <<EOF
Finally:
  • copy the updated public blocks back to your offline backup, so the next
    machine keeps this machine's signing subkey:
EOF
  for id in "${KEYS_RESTORED[@]}"; do
    printf "      %q\n" "${KEYS_PUBLIC[${id}]}"
  done
  cat <<EOF
  • if '${dir}' is a copy rather than the mounted backup drive, remove it:
      ${cleanup}
EOF
}

setup_keys() {
  local dir="${1}" id

  # shellcheck disable=SC2088 # matching a literal tilde on purpose
  case "${dir}" in
  "~") dir="${HOME}" ;;
  "~/"*) dir="${HOME}/${dir#"~/"}" ;;
  "~"*) _error "Give the backup folder as a full path: '${dir%%/*}' is not expanded here" ;;
  esac

  [ -d "${dir}" ] || _error "Backup folder '${dir}' does not exist"
  dir="$(cd "${dir}" && pwd)"

  if [[ -t 0 ]]; then
    NON_INTERACTIVE=false
    GPG_TTY="$(tty)"
    export GPG_TTY
  else
    NON_INTERACTIVE=true
  fi

  export GNUPGHOME="${GPG_HOME}"
  mkdir -p "${GNUPGHOME}"
  chmod 700 "${GNUPGHOME}"

  _info "CHECKING KEYS PHASE PREREQUISITES"
  _keys_preflight "${dir}"

  trap _keys_on_exit EXIT
  trap 'exit 130' INT TERM HUP

  for id in $(_keys_ids); do
    _keys_restore_identity "${id}" "${dir}"
  done

  _keys_configure_git "${dir}"

  for id in $(_keys_ids); do
    _keys_clone_store "${id}" "${dir}"
  done

  _keys_summary "${dir}"
}

# Wiki pass: clone a private notes wiki (or update it if already cloned).
# Separate from the main run because a private repo needs the SSH key that
# the main run creates to be registered first.
setup_wiki() {
  local url="${1}" dir="${AI_WIKI_DIR}"

  if [ -z "${url}" ]; then
    [[ -t 0 ]] || _error "Give the wiki repo URL: ./install --wiki URL"
    read -rp "Git URL of your notes wiki: " url
    [ -n "${url}" ] || _error "Give the wiki repo URL: ./install --wiki URL"
  fi

  if [ -d "${dir}/.git" ]; then
    _info "Updating wiki in ${dir}"
    git -C "${dir}" pull --ff-only || _error "Could not update ${dir}; resolve it by hand"
  elif [ -e "${dir}" ]; then
    _error "${dir} exists but is not a git repository; move it away or set AI_WIKI_DIR"
  else
    _info "Cloning wiki into ${dir}"
    mkdir -p "$(dirname "${dir}")"
    git clone "${url}" "${dir}" || _error "Could not clone ${url}"
  fi
}

_usage() {
  cat <<EOF
Usage examples:

# Pull in remote updates and run the script to update your dotfiles.
./install

# Only pull in remote updates and exit early.
./install --update

# Skip system package installation (Arch, apt, etc).
./install --skip-system-packages

# Update your dotfiles with whatever version of this script that exists locally.
LOCAL=1 ./install

# Enable work PC mode (sets WORK_PC=1 in .zprofile.local, adds a work SSH key)
./install --work-pc

# Keys phase: restore GPG identities and clone the gopass stores.
# Run it after './install' finished, once the SSH key(s) are registered on
# their hosts and your key backup folder is on this machine. DIR must hold
# personal-secret.asc, personal-public.asc and ownertrust.txt, plus
# work-secret.asc and work-public.asc with --work-pc.
./install --keys DIR [--work-pc]

# Wiki pass: clone your private notes wiki to ~/wiki/ai-workflow (or
# AI_WIKI_DIR), or update it. Asks for the URL if none is given. OpenCode
# loads its instructions.md as personal rules when present.
./install --wiki [URL]

# Show this help menu.
./install --help
EOF
}

ARGS=("${@}")

while [ "${#}" -gt 0 ]; do
  case "${1}" in
  --work-pc)
    IS_WORK_PC=1
    ;;
  --update | -u)
    ONLY_UPDATE=1
    ;;
  --skip-system-packages | -S)
    SKIP_SYSTEM_PACKAGES=1
    ;;
  --keys)
    [ -n "${2:-}" ] || _error "'--keys' needs the backup folder, e.g. --keys ~/key-backup"
    KEYS_DIR="${2}"
    shift
    ;;
  --keys=*)
    KEYS_DIR="${1#*=}"
    ;;
  --wiki)
    WIKI_PASS=1
    if [ -n "${2:-}" ] && [ "${2#-}" = "${2}" ]; then
      WIKI_URL="${2}"
      shift
    fi
    ;;
  --wiki=*)
    WIKI_PASS=1
    WIKI_URL="${1#*=}"
    ;;
  --help | -h)
    _usage
    exit
    ;;
  *)
    _error "'${1}' is not a supported flag"
    ;;
  esac
  shift
done

if [ -n "${KEYS_DIR}" ] && [ -n "${WIKI_PASS}" ]; then
  _error "Run '--keys' and '--wiki' one at a time"
fi

if [ -n "${KEYS_DIR}" ]; then
  setup_keys "${KEYS_DIR}"
  exit
fi

if [ -n "${WIKI_PASS}" ]; then
  setup_wiki "${WIKI_URL}"
  exit
fi

detect_env
warn_root
update_dotfiles "${ARGS[@]}" && [ -n "${ONLY_UPDATE}" ] && exit
# Clones below are anonymous HTTPS. The dotfiles' git config rewrites GitHub
# URLs to SSH, and the SSH key this run creates is not registered yet.
export GIT_CONFIG_GLOBAL=/dev/null
check_prereqs
create_initial_dirs
install_packages
clone_dotfiles
install_zsh_plugins
create_symlinks
configure_system_configs
install_wezterm
configure_shell
ask_for_name
ask_for_email
create_ssh_keys
configure_git
# Languages first: npm-backed mise packages (e.g. opencode) need node.
install_programming_languages
install_mise_packages
install_tools_with_python
install_tmux_plugins
install_nvim_plugins
install_powerlevel10k
install_nerdfont
healthcheck
completed_message
