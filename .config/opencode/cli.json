{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "keybinds": {
    "session.first": "ctrl+g",
    "session.last": "ctrl+shift+g",
    "session.tab.next": [
      "ctrl+tab",
      "alt+down",
      "<leader>tab"
    ],
    "session.tab.previous": [
      "ctrl+shift+tab",
      "alt+up",
      "<leader>shift+tab"
    ],
    "session.tab.reopen": [
      "ctrl+shift+t",
      "<leader>shift+t"
    ]
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "medium"
  },
  "animations": true,
  "highlights": true
}
