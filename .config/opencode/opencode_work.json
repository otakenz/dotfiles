{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
	"share": "disabled",
	"model": "opencode/big-pickle",
	"compaction": {
		"auto": false,
		"buffer": 10000
	},
	"agents": {
		"compaction": {
			"model": "opencode/big-pickle"
		}
	},
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			},
			"mcp-atlassian": {
				"type": "local",
				"command": [
					"docker",
					"run",
					"-i",
					"--rm",
					"--env-file",
					"{env:HOME}/.config/secret/mcp-atlassian/.env",
					"ghcr.io/sooperset/mcp-atlassian:0.24.6"
				]
			}
		}
	},
	"permissions": [
		{
			"action": "mcp-atlassian*",
			"resource": "*",
			"effect": "deny"
		}
	],
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"opencode-mem@latest"
	],
	"providers": {
		"aumovio-llmi": {
			"name": "AUMOVIO LLMi",
			"package": "aisdk:@ai-sdk/openai",
			"settings": {
				"baseURL": "https://llm-gateway.ve42034x.automotive-wan.com:443/v1",
				"apiKey": "{env:LLMi_API_TOKEN}"
			},
			"headers": {
				"Authorization": "Bearer {env:LLMi_API_TOKEN}"
			},
			"models": {
				"claude-4-8-opus-v1:0": {
					"name": "Claude Opus 4.8",
					"limit": {
						"context": 1000000,
						"output": 128000
					}
				},
				"claude-5-0-sonnet-v1:0": {
					"name": "Claude Sonnet 5.0",
					"limit": {
						"context": 1000000,
						"output": 128000
					}
				},
				"vertex_ai/claude-opus-5": {
					"name": "Claude Opus 5.0",
					"limit": {
						"context": 1000000,
						"output": 128000
					}
				},
				"gpt-5.6-luna": {
					"name": "GPT 5.6 Luna",
					"limit": {
						"context": 922000,
						"output": 128000
					}
				},
				"gpt-5.6-terra": {
					"name": "GPT 5.6 Terra",
					"limit": {
						"context": 922000,
						"output": 128000
					}
				},
				"gpt-5.6-sol": {
					"name": "GPT 5.6 Sol",
					"limit": {
						"context": 922000,
						"output": 128000
					}
				},
				"DeepSeek-V4-Flash-0731": {
					"name": "DeepSeek V4 Flash",
					"limit": {
						"context": 1000000,
						"output": 384000
					}
				},
				"DeepSeek-V4-Pro": {
					"name": "DeepSeek V4 Pro",
					"limit": {
						"context": 1000000,
						"output": 384000
					}
				}
			}
		}
	}
}
