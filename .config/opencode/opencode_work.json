{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
	"share": "disabled",
	"instructions": ["~/wiki/ai-workflow/instructions.md"],
	"model": "opencode/big-pickle",
	"compaction": {
		"auto": true
	},
	"agents": {
		"compaction": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"explore": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"general": {
			"model": "github-copilot/claude-sonnet-5.5"
		},
		"coder": {
			"model": "github-copilot/claude-sonnet-5.5"
		},
		"investigator": {
			"model": "github-copilot/claude-sonnet-5.5"
		},
		"scribe": {
			"model": "github-copilot/claude-sonnet-5.5"
		},
		"reviewer": {
			"model": "github-copilot/gpt-6.2-sol"
		},
		"cpp-reviewer": {
			"model": "github-copilot/gpt-6.2-sol"
		}
	},
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			},
			"mcp-atlassian": {
				"type": "local",
				"command": [
					"uvx",
					"mcp-atlassian==0.24.6",
					"--env-file",
					"{env:HOME}/.config/secret/mcp-atlassian/.env"
				]
			}
		}
	},
	"permissions": [
		{
			"action": "mcp-atlassian*",
			"resource": "*",
			"effect": "deny"
		}
	],
	"policies": [
		{
			"action": "tool.use",
			"resource": "shell:*work-unattended*",
			"effect": "deny"
		},
		{
			"action": "tool.use",
			"resource": "read:*/gopass/stores/work-unattended/*",
			"effect": "deny"
		}
	],
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"opencode-mem@latest",
		"@slkiser/opencode-quota@latest",
		{
			"package": "./plugins/llmi",
			"options": {
				"enabled": true,
				"bridge": true,
				"refreshSeconds": 900
			}
		}
	]
}
