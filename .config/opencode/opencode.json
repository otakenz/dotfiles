{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
	"share": "disabled",
	"model": "opencode/big-pickle",
	"compaction": {
		"auto": false,
		"buffer": 10000
	},
	"agents": {
		"compaction": {
			"model": "opencode/big-pickle"
		}
	},
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			}
		}
	},
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"opencode-mem@latest"
	]
}
