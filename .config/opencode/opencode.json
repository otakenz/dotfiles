{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
	"share": "disabled",
	"instructions": ["~/wiki/ai-workflow/instructions.md"],
	"skills": ["~/wiki/ai-workflow/skills"],
	"model": "opencode/big-pickle",
	"compaction": {
		"auto": true
	},
	"agents": {
		"compaction": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"explore": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"general": {
			"model": "opencode-go/hy4"
		},
		"coder": {
			"model": "opencode-go/hy4"
		},
		"investigator": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"scribe": {
			"model": "opencode-go/deepseek-v4.1-flash"
		},
		"reviewer": {
			"model": "opencode-go/qwen4-max"
		},
		"cpp-reviewer": {
			"model": "opencode-go/qwen4-max"
		}
	},
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			}
		}
	},
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"opencode-mem@latest",
		"@slkiser/opencode-quota@latest"
	]
}
