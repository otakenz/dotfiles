#!/usr/bin/env bash

set -o errexit
set -o pipefail

lint() {
  # Lint all supported file types
  local shellcheck_cmd=(shellcheck)
  local ruff_cmd=(ruff)

  if ! command -v shellcheck >/dev/null 2>&1; then
    local shellcheck_cmd=(docker container run --rm -i -v "${PWD}:/mnt" koalaman/shellcheck:stable)
  fi

  if ! command -v ruff >/dev/null 2>&1; then
    local ruff_cmd=(docker container run --rm -i -v "${PWD}:/io" -u "$(id -u):$(id -g)" ghcr.io/astral-sh/ruff:0.11.1)
  fi

  find . -type f \
    ! -path "./.git/*" \
    ! -path "./.ruff_cache/*" \
    ! -path "./.pytest_cache/*" \
    ! -path "./.config/opencode/skills/*" \
    ! -path "*/node_modules/*" \
    -exec grep --quiet -E '^(#!.*sh|# shellcheck shell=)' {} \; -exec "${shellcheck_cmd[@]}" {} +

  "${ruff_cmd[@]}" check "${@}"
}

format() {
  # Format all supported file types
  local shfmt_cmd=(shfmt)
  local ruff_cmd=(ruff)

  if ! command -v shfmt >/dev/null 2>&1; then
    local shfmt_cmd=(docker container run --rm -i -v "${PWD}:/mnt" -u "$(id -u):$(id -g)" -w /mnt mvdan/shfmt:v3)
  fi

  if ! command -v ruff >/dev/null 2>&1; then
    local ruff_cmd=(docker container run --rm -i -v "${PWD}:/io" -u "$(id -u):$(id -g)" ghcr.io/astral-sh/ruff:0.11.1)
  fi

  local shfmt_args=("--write")
  local check=""

  for arg in "${@}"; do
    [ "${arg}" == "--check" ] && shfmt_args+=("--diff") && check=1

    if [ "${arg}" == "-d" ] || [ "${arg}" == "--diff" ] || [ "${shfmt_args[1]}" == "--diff" ]; then
      unset "shfmt_args[0]"
    fi
  done

  "${shfmt_cmd[@]}" "${shfmt_args[@]}" . .config/zsh/.{aliases,zprofile,zshrc}

  # --check must not modify files (pre-commit hook, CI); lint covers ruff check.
  [ -n "${check}" ] || "${ruff_cmd[@]}" check --fix
  "${ruff_cmd[@]}" format "${@}"
}

quality() {
  # Perform all code quality commands together
  lint "${@}"
  format "${@}"
}

ci:test() {
  # Execute Continuous Integration (CI) pipeline
  lint
  format --check --diff
}

ci:keys() {
  # Test `./install --keys` against generated identities and local stores
  bash test/keys.sh
}

ci:wiki() {
  # Test `./install --wiki` against a local wiki repo
  bash test/wiki.sh
}

ci:keys:linux() {
  # Run the keys test in Ubuntu 24.04, Ubuntu 26.04 and Arch Linux containers
  local image status=0
  local ca=() ca_dir="/usr/local/share/ca-certificates"

  # Behind a TLS-intercepting proxy the containers need the host's extra CAs.
  if compgen -G "${ca_dir}/*.crt" >/dev/null; then
    ca=(-v "${ca_dir}:/extra-ca:ro" -e EXTRA_CA_DIR=/extra-ca)
  fi

  for image in ubuntu:24.04 ubuntu:26.04 archlinux:latest; do
    printf "\n:: %s\n" "${image}"
    docker container run --rm "${ca[@]}" -v "${PWD}:/repo:ro" -w /repo "${image}" \
      bash -c "bash test/deps.sh >/dev/null && bash test/keys.sh" || status=1
  done

  return "${status}"
}

ci:install:linux() {
  # Run the full install smoke test in one container: ./run ci:install:linux ubuntu:24.04
  local image="${1:-ubuntu:24.04}"
  local ca=() ca_dir="/usr/local/share/ca-certificates"

  if compgen -G "${ca_dir}/*.crt" >/dev/null; then
    local bundle=/etc/ssl/certs/ca-certificates.crt
    ca=(-v "${ca_dir}:/extra-ca:ro" -e EXTRA_CA_DIR=/extra-ca
      -e NODE_EXTRA_CA_CERTS="${bundle}" -e PIP_CERT="${bundle}"
      -e REQUESTS_CA_BUNDLE="${bundle}" -e SSL_CERT_FILE="${bundle}")
  fi

  # A normal run takes ~10 minutes; a hang must fail fast, not run all night.
  timeout -k 1m 20m docker container run --rm --init "${ca[@]}" -e CI=true -e IN_CONTAINER=1 \
    -e DEBIAN_FRONTEND=noninteractive -v "${PWD}:/src:ro" "${image}" bash -c \
    "set -eo pipefail; cp -R /src /app; rm -rf /app/.git /app/vscode-llmi/node_modules /app/vscode-llmi/dist; cd /app; bash test/install-prep.sh; { yes || true; } | LOCAL=1 bash install; bash test/install-check.sh"
}

help() {
  printf "%s <task> [args]\n\nTasks:\n" "${0}"

  compgen -A function | grep -v "^_" | cat -n

  printf "\nExtended help:\n  Each task has comments for general usage\n"
}

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
