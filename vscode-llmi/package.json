{
  "name": "llmi-models",
  "displayName": "AUMOVIO LLMi models",
  "description": "Keeps the AUMOVIO LLMi models for GitHub Copilot chat in sync with the LLMi gateway and shows the LLMi budget.",
  "version": "0.1.0",
  "publisher": "aumovio-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "llmi.setKey",
        "title": "LLMi: Set API Key"
      },
      {
        "command": "llmi.refresh",
        "title": "LLMi: Refresh Models"
      }
    ],
    "configuration": {
      "title": "LLMi",
      "properties": {
        "llmi.refreshMinutes": {
          "type": "number",
          "default": 15,
          "description": "How often to reload the model list from the gateway (0 = only at startup and on demand).",
          "scope": "application"
        },
        "llmi.userId": {
          "type": "string",
          "default": "",
          "description": "LLMi user id for the budget in the status bar. Empty: your login name.",
          "scope": "application"
        },
        "llmi.languageModelsFile": {
          "type": "string",
          "default": "",
          "description": "Path of chatLanguageModels.json. Empty: the one in your VS Code User folder.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode",
    "test": "bun test",
    "package": "bun run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license",
    "check": "tsc -p . && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "22",
    "@types/vscode": "1.104.0",
    "typescript": "^7.0.2"
  },
  "extensionKind": [
    "ui"
  ],
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
